# ===========================================
# Assistant de Direction — Variables d'environnement
# ===========================================
# Copier ce fichier en .env et remplir les valeurs.
# Le .env NE DOIT JAMAIS etre commite (deja dans .gitignore).


# =====================================================
# --- LLM (Groq) ---
# =====================================================
# Obtenir une cle gratuite sur https://console.groq.com/keys
GROQ_API_KEY=

# Modele LLM a utiliser (doit supporter tool calling)
GROQ_MODEL=llama-3.3-70b-versatile


# =====================================================
# --- PostgreSQL (utilise par docker-compose) ---
# =====================================================
# Identifiants de la base PostgreSQL.
POSTGRES_USER=assistant
POSTGRES_PASSWORD=CHANGE-ME-postgres-password-fort
POSTGRES_DB=assistant_direction

# Port HOST de PostgreSQL (port interne reste 5432 dans le reseau Docker).
# Non-standard pour eviter les conflits avec un Postgres deja installe.
# Bind sur 127.0.0.1 uniquement (pas expose publiquement).
POSTGRES_PORT=15432


# =====================================================
# --- API FastAPI ---
# =====================================================
# Port HOST de l'API (port interne du container reste 8000).
# Non-standard. Bind sur 127.0.0.1 uniquement — le reverse proxy
# (nginx, caddy, traefik) du serveur l'expose en HTTPS.
API_PORT=8421

# URL de connexion SQLAlchemy. En docker-compose elle est CONSTRUITE
# automatiquement depuis POSTGRES_* (voir docker-compose.yml).
# Decommente uniquement si tu lances l'API hors Docker :
# DATABASE_URL=postgresql://assistant:CHANGE-ME-postgres-password-fort@127.0.0.1:15432/assistant_direction


# =====================================================
# --- Auth / JWT ---
# =====================================================
# IMPORTANT : generer une valeur forte en prod, par ex. :
#   openssl rand -hex 32
JWT_SECRET_KEY=CHANGE-ME-jwt-secret-utiliser-openssl-rand-hex-32
JWT_ALGORITHM=HS256
# Duree de validite d'un access token, en minutes (1440 = 24h).
JWT_EXPIRE_MINUTES=1440


# =====================================================
# --- CORS ---
# =====================================================
# Liste d'origines autorisees, separees par des virgules.
# "*" autorise tout (recommande pour un environnement de test ouvert
# a plusieurs candidats deployant chacun leur front sur Vercel/Netlify).
# Exemple restrictif : http://localhost:5173,https://mon-front.vercel.app
CORS_ORIGINS=*


# =====================================================
# --- Logs ---
# =====================================================
LOG_LEVEL=INFO


# =====================================================
# Note : 5 comptes demo sont seedes automatiquement au demarrage
# (user1@inov-consulting.com .. user5@inov-consulting.com / Innov2026!).
# Voir src/db/seed.py.
# =====================================================
